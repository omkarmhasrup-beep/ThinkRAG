# --- Database Connections ---
# Unified Database: Supabase PostgreSQL (Production Deployment)
# Use the URI format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: postgresql:// or postgres:// schemas will automatically be rewritten to postgresql+psycopg:// to use the correct driver.
# This database will be used for BOTH relational data (users/chats) and vector embeddings (pgvector).
DATABASE_URL=

# --- LLM API Credentials & Config ---
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini

# SMTP Email Settings
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-username
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com
# FRONTEND_URL=http://localhost:5173
